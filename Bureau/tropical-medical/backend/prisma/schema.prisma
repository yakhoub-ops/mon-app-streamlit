generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── UTILISATEUR & PROFILS ────────────────────────────────────────────────────

model Utilisateur {
  id           Int      @id @default(autoincrement())
  nom          String
  prenom       String
  email        String   @unique
  telephone    String?
  mot_de_passe String
  role         String   // ROLES.* : PATIENT | MEDECIN | RECEPTIONNISTE | PHARMACIEN | ADMIN
  actif        Boolean  @default(true)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  medecin              Medecin?
  patient              Patient?
  preferences          PreferencesUtilisateur?
  notifications        Notification[]
  messagesEnvoyes      Interaction[] @relation("MessagesEnvoyes")
  messagesRecus        Interaction[] @relation("MessagesRecus")
  actualites           Actualite[]
}

model PreferencesUtilisateur {
  id            Int    @id @default(autoincrement())
  utilisateurId Int    @unique
  langue        String @default("FR")    // LANGUE.*
  theme         String @default("CLAIR") // THEME.*

  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
}

model Medecin {
  id                      Int     @id @default(autoincrement())
  utilisateurId           Int     @unique
  specialite              String
  numeroOrdre             String?
  description             String?
  consultationTarif       Int     @default(5000) // FCFA
  teleconsultationActive  Boolean @default(false)

  utilisateur        Utilisateur         @relation(fields: [utilisateurId], references: [id])
  rendezvous         RendezVous[]
  consultations      Consultation[]
  teleconsultations  Teleconsultation[]
  passagesFileAttente PassageFileAttente[]
}

model Patient {
  id            Int       @id @default(autoincrement())
  utilisateurId Int       @unique
  dateNaissance DateTime?
  sexe          String?   // M | F
  adresse       String?
  groupeSanguin String?
  allergies               String?   // JSON texte
  antecedents             String?   // JSON texte (maladies passées)
  maladiesChroniques      String?   // JSON texte
  antecedentsFamiliaux    String?   // JSON texte
  chirurgies              String?   // JSON texte
  hospitalisationsPrecedentes String? // JSON texte
  contactUrgenceNom       String?
  contactUrgenceTelephone String?
  numeroIdentification    String?
  assuranceId   Int?

  utilisateur          Utilisateur          @relation(fields: [utilisateurId], references: [id])
  assurance            Assurance?           @relation(fields: [assuranceId], references: [id])
  rendezvous           RendezVous[]
  dossier              DossierMedical?
  hospitalisations     Hospitalisation[]
  factures             Facture[]
  passagesFileAttente  PassageFileAttente[]
}

model Assurance {
  id             Int    @id @default(autoincrement())
  type           String // TYPE_ASSURANCE.* : CMU | CNSS | IPM | PRIVEE
  organisme      String
  numero         String
  tauxCouverture Int    @default(80) // pourcentage

  patients       Patient[]
}

// ─── RENDEZ-VOUS & FILE D'ATTENTE ────────────────────────────────────────────

model RendezVous {
  id        Int      @id @default(autoincrement())
  patientId Int
  medecinId Int
  date      DateTime
  type      String   @default("PRESENTIEL") // TYPE_RDV.*
  statut    String   @default("EN_ATTENTE") // STATUT_RDV.*
  motif     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient            Patient              @relation(fields: [patientId], references: [id])
  medecin            Medecin              @relation(fields: [medecinId], references: [id])
  teleconsultation   Teleconsultation?
  passageFileAttente PassageFileAttente?
}

model PassageFileAttente {
  id            Int       @id @default(autoincrement())
  patientId     Int
  medecinId     Int?
  rendezvousId  Int?      @unique
  niveauUrgence String    @default("FAIBLE") // NIVEAU_URGENCE.*
  statut        String    @default("EN_ATTENTE") // STATUT_PASSAGE.*
  motif         String?
  heureArrivee  DateTime  @default(now())
  heureAppel    DateTime?
  createdAt     DateTime  @default(now())

  patient      Patient     @relation(fields: [patientId], references: [id])
  medecin      Medecin?    @relation(fields: [medecinId], references: [id])
  rendezvous   RendezVous? @relation(fields: [rendezvousId], references: [id])
  consultation Consultation?
}

// ─── DOSSIER & CONSULTATION ───────────────────────────────────────────────────

model DossierMedical {
  id            Int      @id @default(autoincrement())
  patientId     Int      @unique
  numeroDossier String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       Patient         @relation(fields: [patientId], references: [id])
  consultations Consultation[]
  ordonnances   Ordonnance[]
  vaccinations  Vaccination[]
  examens       ExamenMedical[]
}

model Vaccination {
  id                  Int       @id @default(autoincrement())
  dossierId           Int
  nom                 String
  dateAdministration  DateTime
  rappelPrevu         DateTime?
  rappelEffectue      Boolean   @default(false)
  notes               String?
  createdAt           DateTime  @default(now())

  dossier DossierMedical @relation(fields: [dossierId], references: [id])
}

model ExamenMedical {
  id             Int      @id @default(autoincrement())
  dossierId      Int
  consultationId Int?
  type           String   @default("AUTRE") // LABORATOIRE | RADIOLOGIE | ECHOGRAPHIE | SCANNER | IRM | AUTRE
  titre          String
  description    String?
  resultats      String?
  date           DateTime @default(now())
  fichier        String?
  createdAt      DateTime @default(now())

  dossier      DossierMedical @relation(fields: [dossierId], references: [id])
  consultation Consultation?  @relation(fields: [consultationId], references: [id])
}

model Consultation {
  id             Int       @id @default(autoincrement())
  dossierId      Int
  medecinId      Int
  passageId      Int?      @unique
  date           DateTime  @default(now())
  motif          String?
  anamnese       String?
  examenClinique String?
  diagnostic     String?
  traitement     String?
  notes          String?
  prochainRdv    DateTime?
  createdAt      DateTime  @default(now())

  dossier     DossierMedical      @relation(fields: [dossierId], references: [id])
  medecin     Medecin             @relation(fields: [medecinId], references: [id])
  passage     PassageFileAttente? @relation(fields: [passageId], references: [id])
  ordonnances Ordonnance[]
  examens     ExamenMedical[]
  facture     Facture?
}

// ─── ORDONNANCES & MÉDICAMENTS ────────────────────────────────────────────────

model Ordonnance {
  id             Int       @id @default(autoincrement())
  dossierId      Int
  consultationId Int?
  medecinNom     String
  date           DateTime  @default(now())
  statut         String    @default("ACTIVE") // STATUT_ORDONNANCE.*
  expirationDate DateTime?
  instructions   String?
  createdAt      DateTime  @default(now())

  dossier      DossierMedical @relation(fields: [dossierId], references: [id])
  consultation Consultation?  @relation(fields: [consultationId], references: [id])
  lignes       LigneOrdonnance[]
}

model LigneOrdonnance {
  id           Int    @id @default(autoincrement())
  ordonnanceId Int
  medicamentId Int
  posologie    String
  duree        String?
  quantite     Int    @default(1)

  ordonnance  Ordonnance @relation(fields: [ordonnanceId], references: [id])
  medicament  Medicament @relation(fields: [medicamentId], references: [id])
}

model Medicament {
  id            Int     @id @default(autoincrement())
  nom           String
  dci           String? // Dénomination Commune Internationale
  forme         String? // comprimé | sirop | injection | pommade
  dosage        String?
  categorie     String?
  prixUnitaire  Int     @default(0) // FCFA
  stockActuel   Int     @default(0)
  stockMinimum  Int     @default(10)
  description   String?
  urlFournisseur String?
  actif         Boolean @default(true)

  lignesOrdonnance LigneOrdonnance[]
  lots             LotMedicament[]
}

model LotMedicament {
  id               Int      @id @default(autoincrement())
  medicamentId     Int
  numeroLot        String
  dateExpiration   DateTime
  quantite         Int
  quantiteRestante Int
  fournisseur      String?
  prixAchat        Int?     // FCFA
  createdAt        DateTime @default(now())

  medicament Medicament @relation(fields: [medicamentId], references: [id])
}

// ─── HOSPITALISATION & LITS ───────────────────────────────────────────────────

model Lit {
  id     Int    @id @default(autoincrement())
  numero String @unique
  chambre String
  etage  Int    @default(0)
  type   String @default("STANDARD")    // TYPE_CHAMBRE.*
  statut String @default("LIBRE")       // STATUT_LIT.*
  notes  String?

  hospitalisations Hospitalisation[]
}

model Hospitalisation {
  id            Int       @id @default(autoincrement())
  patientId     Int
  litId         Int
  medecinId     Int?
  dateAdmission DateTime  @default(now())
  dateSortie    DateTime?
  statut        String    @default("EN_COURS") // STATUT_HOSPITALISATION.*
  motif         String?
  diagnostic    String?
  notes         String?
  coutParJour   Int       @default(15000) // FCFA
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  lit     Lit     @relation(fields: [litId], references: [id])
}

// ─── FACTURATION & PAIEMENTS ──────────────────────────────────────────────────

model Facture {
  id               Int      @id @default(autoincrement())
  patientId        Int
  consultationId   Int?     @unique
  numero           String   @unique
  date             DateTime @default(now())
  montantTotal     Int      @default(0) // FCFA
  montantAssurance Int      @default(0) // FCFA
  montantPatient   Int      @default(0) // FCFA
  statut           String   @default("EN_ATTENTE") // STATUT_PAIEMENT.*
  notes            String?
  createdAt        DateTime @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  lignes       LigneFacture[]
  paiements    Paiement[]
}

model LigneFacture {
  id           Int    @id @default(autoincrement())
  factureId    Int
  description  String
  quantite     Int    @default(1)
  prixUnitaire Int    // FCFA
  montant      Int    // FCFA

  facture Facture @relation(fields: [factureId], references: [id])
}

model Paiement {
  id        Int      @id @default(autoincrement())
  factureId Int
  montant   Int      // FCFA
  mode      String   // MODE_PAIEMENT.*
  statut    String   @default("EN_ATTENTE") // STATUT_PAIEMENT.*
  date      DateTime @default(now())
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  facture           Facture            @relation(fields: [factureId], references: [id])
  transactionMobile TransactionMobile?
}

model TransactionMobile {
  id         Int      @id @default(autoincrement())
  paiementId Int      @unique
  operateur  String   // OPERATEUR_MOBILE.*
  telephone  String
  statut     String   @default("EN_ATTENTE") // STATUT_TRANSACTION.*
  reference  String?
  createdAt  DateTime @default(now())

  paiement Paiement @relation(fields: [paiementId], references: [id])
}

// ─── TÉLÉCONSULTATION ────────────────────────────────────────────────────────

model Teleconsultation {
  id           Int       @id @default(autoincrement())
  rendezvousId Int       @unique
  medecinId    Int
  urlVisio     String
  plateforme   String    @default("JITSI") // PLATEFORME_VISIO.*
  statut       String    @default("PLANIFIEE") // STATUT_TELECONSULT.*
  dateDebut    DateTime?
  dateFin      DateTime?
  duree        Int?      // minutes
  notes        String?
  createdAt    DateTime  @default(now())

  rendezvous RendezVous @relation(fields: [rendezvousId], references: [id])
  medecin    Medecin    @relation(fields: [medecinId], references: [id])
}

// ─── NOTIFICATIONS & ACTUALITÉS ──────────────────────────────────────────────

model Notification {
  id            Int       @id @default(autoincrement())
  utilisateurId Int
  titre         String
  message       String
  canal         String    @default("IN_APP") // CANAL_NOTIFICATION.*
  statut        String    @default("PLANIFIE") // STATUT_NOTIFICATION.*
  lien          String?
  lu            Boolean   @default(false)
  createdAt     DateTime  @default(now())
  envoyeAt      DateTime?

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
}

model Actualite {
  id        Int      @id @default(autoincrement())
  titre     String
  contenu   String
  image     String?
  categorie String   @default("INFO") // INFO | DON_SANG | VACCINATION | SENSIBILISATION | EVENEMENT | URGENCE
  auteurId  Int?
  publiee   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auteur    Utilisateur? @relation(fields: [auteurId], references: [id])
}

model Interaction {
  id             Int      @id @default(autoincrement())
  expediteurId   Int
  destinataireId Int
  message        String
  lu             Boolean  @default(false)
  createdAt      DateTime @default(now())

  expediteur   Utilisateur @relation("MessagesEnvoyes", fields: [expediteurId], references: [id])
  destinataire Utilisateur @relation("MessagesRecus",   fields: [destinataireId], references: [id])
}
