# ───────────────────────────────────────────
#  Tropical Medical — .gitignore
# ───────────────────────────────────────────

# ── Dépendances ─────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Variables d'environnement ────────────────
# Garder uniquement les .env.example (modèles sans secrets)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ── Base de données SQLite ─────────────────── 
*.db
*.db-journal
*.db-wal
*.db-shm
backend/prisma/dev.db
backend/prisma/dev.db-journal

# ── Prisma client généré ─────────────────────
backend/generated/

# ── Build frontend (Vite) ───────────────────
frontend/dist/
frontend/dist-ssr/

# ── Logs ────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Cache & outils ──────────────────────────
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ── Tests & couverture ───────────────────────
coverage/
.nyc_output/

# ── Éditeurs ────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Système d'exploitation ───────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Uploads utilisateur (si dossier local) ──
backend/uploads/
